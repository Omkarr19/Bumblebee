# BlindSpot AI Environment Variables
# Provide at least one LLM API key. If none is provided, BlindSpot AI will operate in simulated reasoning mode with pre-baked high-fidelity domain intelligence.

# Recommended: Google Gemini API (Get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative: Groq API (Ultra-fast inference: https://console.groq.com/)
GROQ_API_KEY=

# Alternative: OpenAI API (https://platform.openai.com/)
OPENAI_API_KEY=

# Optional model override
# GEMINI_MODEL=gemini-1.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-4o-mini

